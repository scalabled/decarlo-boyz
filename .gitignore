# No trailing slash: in a worktree this is a SYMLINK to the main checkout's
# node_modules, and `node_modules/` (directories only) does not match a link —
# `git add -A` would stage it as a blob.
node_modules
dist/
shots/
legacy/
tools/workflows/
SESSION-REPORT.md
REVIEW.md
nodeonly.txt
.DS_Store
*.swp
.idea/
.vscode/
# Verifier A/B scaffolding: detached git worktrees agents create to compare
# the working tree against HEAD. Never ship; a nested .git staged by add -A
# would become a bogus submodule gitlink.
headtree/
minetree/
